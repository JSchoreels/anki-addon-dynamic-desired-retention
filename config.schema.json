{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query", "desired_retention"],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "desired_retention": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "grade_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["grade", "mode", "value"],
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "absolute"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "relative"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": -1,
                  "maximum": 1
                }
              }
            }
          }
        ],
        "properties": {
          "grade": {
            "type": "string",
            "enum": ["again", "hard", "good", "easy"]
          },
          "mode": {
            "type": "string",
            "enum": ["absolute", "relative"]
          },
          "value": {
            "type": "number"
          }
        }
      }
    },
    "field_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["note_type", "field", "value_type", "thresholds"],
        "properties": {
          "note_type": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "scope_query": {
            "type": "string"
          },
          "filter_query": {
            "type": "string"
          },
          "field_value_mode": {
            "type": "string",
            "enum": ["absolute", "relative"]
          },
          "relative_top_direction": {
            "type": "string",
            "enum": ["lower", "higher"]
          },
          "value_type": {
            "type": "string",
            "enum": ["number", "text"]
          },
          "linear_between_thresholds": {
            "type": "boolean"
          },
          "minimum_desired_retention": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "minimum_retention_minimum_interval": {
            "type": "integer",
            "minimum": 1
          },
          "minimum_retention_maximum_interval": {
            "type": "integer",
            "minimum": 1
          },
          "thresholds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "desired_retention"],
              "properties": {
                "value": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "number"
                    }
                  ]
                },
                "desired_retention": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "minimum_interval": {
                  "type": "integer",
                  "minimum": 1
                },
                "maximum_interval": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "required": ["rules"]
}
